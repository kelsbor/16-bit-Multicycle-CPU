-- ============================================================================
-- Arquivo de Inicializacao de Memoria (ram_init.mif)
-- Arquitetura: CPU Multiciclo 16 bits (256 palavras x 16 bits)
-- ============================================================================
-- Estado inicial do register_bank.vhd:
--   $0 = 0x0000 (fixo em zero)
--   $1 = 0x0005 (5)
--   $2 = 0x0003 (3)
-- ============================================================================
-- Formato das Instrucoes (16 bits):
--   Tipo R: [15..12 Opcode] [11..9 Ri] [8..6 Rj] [5..3 Rk] [2..0 Funct]
--   Tipo I: [15..12 Opcode] [11..9 Ri] [8..6 Rj] [5..0 Imediato (complemento de 2)]
--   Tipo J: [15..12 Opcode] [11..0 Endereco de destino]
-- ============================================================================

WIDTH=16;
DEPTH=256;

ADDRESS_RADIX=HEX;
DATA_RADIX=BIN;

CONTENT BEGIN
    -- ------------------------------------------------------------------------
    -- 1. TESTE DE INSTRUCOES TIPO R (AluOp = 10, usa Funct)
    -- ------------------------------------------------------------------------
    
    -- PC = 0x00: ADD $3, $1, $2  ->  $3 = $1 + $2 = 5 + 3 = 8 (0x0008)
    -- Opcode=0000 (ADD), Ri=011 ($3), Rj=001 ($1), Rk=010 ($2), Funct=010 (AddOp)
    00 : 0000011001010010;

    -- PC = 0x01: SUB $4, $1, $2  ->  $4 = $1 - $2 = 5 - 3 = 2 (0x0002)
    -- Opcode=0001 (SUB), Ri=100 ($4), Rj=001 ($1), Rk=010 ($2), Funct=100 (SubOp)
    01 : 0001100001010100;

    -- PC = 0x02: AND $5, $1, $2  ->  $5 = $1 & $2 = 5 & 3 = 1 (0x0001)
    -- Opcode=0010 (AND), Ri=101 ($5), Rj=001 ($1), Rk=010 ($2), Funct=000 (AndOp)
    02 : 0010101001010000;

    -- PC = 0x03: OR  $6, $1, $2  ->  $6 = $1 | $2 = 5 | 3 = 7 (0x0007)
    -- Opcode=0011 (OR), Ri=110 ($6), Rj=001 ($1), Rk=010 ($2), Funct=001 (OrOp)
    03 : 0011110001010001;

    -- PC = 0x04: SLT $7, $2, $1  ->  $7 = ($2 < $1) ? 1 : 0 = (3 < 5) = 1 (0x0001)
    -- Opcode=0100 (SLT), Ri=111 ($7), Rj=010 ($2), Rk=001 ($1), Funct=110 (SltOp)
    04 : 0100111010001110;

    -- ------------------------------------------------------------------------
    -- 2. TESTE DE INSTRUCAO IMEDIATA (ADDI) E ACESSO A MEMORIA (ST / LD)
    -- ------------------------------------------------------------------------

    -- PC = 0x05: ADDI $3, $3, 4  ->  $3 = $3 + 4 = 8 + 4 = 12 (0x000C)
    -- Opcode=0101 (ADDI), Ri=011 ($3), Rj=011 ($3), Imm=000100 (4)
    05 : 0101011011000100;

    -- PC = 0x06: ST $3, $0, 16   ->  Mem[0 + 16 (0x10)] = $3 (salva 0x000C na posicao 0x10)
    -- Opcode=0111 (ST), Ri=011 ($3 - dado), Rj=000 ($0 - base), Imm=010000 (16 = 0x10)
    06 : 0111011000010000;

    -- PC = 0x07: LD $4, $0, 16   ->  $4 = Mem[0 + 16 (0x10)] = 0x000C (carrega 0x000C no RDM e em $4)
    -- Opcode=0110 (LD), Ri=100 ($4 - destino), Rj=000 ($0 - base), Imm=010000 (16 = 0x10)
    07 : 0110100000010000;

    -- ------------------------------------------------------------------------
    -- 3. TESTE DE IMEDIATO NEGATIVO (ADDI) E SLT FALSO (RESULTADO = 0)
    -- ------------------------------------------------------------------------

    -- PC = 0x08: ADDI $4, $4, -2 ->  $4 = $4 + (-2) = 12 - 2 = 10 (0x000A)
    -- Opcode=0101 (ADDI), Ri=100 ($4), Rj=100 ($4), Imm=111110 (-2 em complemento de 2)
    08 : 0101100100111110;

    -- PC = 0x09: SLT $7, $1, $2  ->  $7 = ($1 < $2) ? 1 : 0 = (5 < 3) = 0 (0x0000)
    -- Opcode=0100 (SLT), Ri=111 ($7), Rj=001 ($1), Rk=010 ($2), Funct=110 (SltOp)
    09 : 0100111001010110;

    -- ------------------------------------------------------------------------
    -- 4. TESTE DE DESVIOS CONDICIONAIS (BNE / BEQ: TOMADO, NAO TOMADO E NEGATIVO) E JMP
    -- ------------------------------------------------------------------------

    -- PC = 0x0A: BEQ $3, $4, 2   ->  $3 (12) != $4 (10), entao NAO salta! Vai para PC = 0x0B
    -- Opcode=1000 (BEQ), Ri=011 ($3), Rj=100 ($4), Imm=000010 (2)
    0A : 1000011100000010;

    -- PC = 0x0B: BNE $3, $4, 1   ->  $3 (12) != $4 (10), entao SALTA! PC = 0x0C + 1 = 0x0D (pula 0x0C)
    -- Opcode=1001 (BNE), Ri=011 ($3), Rj=100 ($4), Imm=000001 (1)
    0B : 1001011100000001;

    -- PC = 0x0C: ADD $1, $0, $0  ->  Instrucao armadilha (deve ser pulada pelo BNE acima!)
    0C : 0000001000000010;

    -- PC = 0x0D: BEQ $3, $3, 1   ->  $3 == $3, entao SALTA! PC = 0x0E + 1 = 0x0F (pula 0x0E)
    -- Opcode=1000 (BEQ), Ri=011 ($3), Rj=011 ($3), Imm=000001 (1)
    0D : 1000011011000001;

    -- PC = 0x0E: ADD $2, $0, $0  ->  Instrucao armadilha (deve ser pulada pelo BEQ acima!)
    0E : 0000010000000010;

    -- PC = 0x0F: JMP 0x011       ->  Salta para 0x11 para testar desvio condicional com offset negativo
    -- Opcode=1010 (JMP), Endereco=000000010001 (0x011)
    0F : 1010000000010001;

    -- PC = 0x10: JMP 0x000       ->  Alvo do salto reverso: reinicia o programa (PC = 0x0000)
    -- Opcode=1010 (JMP), Endereco=000000000000 (0x000)
    10 : 1010000000000000;

    -- PC = 0x11: BEQ $0, $0, -2  ->  $0 == $0, SALTA PARA TRAS! PC = 0x12 + (-2) = 0x10
    -- Opcode=1000 (BEQ), Ri=000 ($0), Rj=000 ($0), Imm=111110 (-2 em complemento de 2)
    11 : 1000000000111110;

    -- ------------------------------------------------------------------------
    -- AREA DE DADOS / RESTANTE DA MEMORIA ZERADA
    -- ------------------------------------------------------------------------
    [12..FF] : 0000000000000000;
END;
